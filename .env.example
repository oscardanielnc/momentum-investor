# investor - configuration template. Copy to `.env` and fill in your own values.
#   cp .env.example .env      (Linux/macOS)   ·   copy .env.example .env   (Windows)
# `.env` is gitignored. Never commit real keys.
# Every variable below is optional unless marked REQUIRED; defaults are shown commented out.

# --- Alpaca (broker + market data) ---------------------------------------------------------
# REQUIRED for the robot, the dashboard and the Alpaca-based research scripts.
# Use PAPER keys (https://app.alpaca.markets/paper/dashboard/overview).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Execution mode ------------------------------------------------------------------------
# INVESTOR_DRY_RUN=true                            -> log only, no orders (safe default)
# INVESTOR_DRY_RUN=false + INVESTOR_ALPACA_LIVE=false -> PAPER account (simulated money)
# INVESTOR_DRY_RUN=false + INVESTOR_ALPACA_LIVE=true  -> LIVE account (real money)
INVESTOR_DRY_RUN=true
INVESTOR_ALPACA_LIVE=false

# --- Robot tuning (defaults match the configuration studied in research/) ------------------
# INVESTOR_HEARTBEAT_S=900         # seconds between cycles
# INVESTOR_CB_HALT=0.25            # circuit breaker: flatten at a 25% drawdown
# INVESTOR_CB_RESUME=0.15          # resume once back within 15% of the peak
# INVESTOR_REBAL_BAND=0.05         # monthly: re-weight only if drift exceeds 5%
# INVESTOR_EXIT_RANK=12            # daily hysteresis band (research/backtest_v9_hysteresis.py)
# INVESTOR_MIN_ORDER_USD=1         # smallest order sent
# INVESTOR_CAPITAL_FALLBACK=500    # equity reported in DRY_RUN mode

# --- Dashboard -----------------------------------------------------------------------------
# INVESTOR_DASHBOARD_PORT=8080

# --- Optional AI prose for each rebalance (without a key a deterministic text is used) -----
# AI_ENGINE=deepseek               # deepseek | glm | claude
DEEPSEEK_API_KEY=
# GLM_API_KEY=                     # or ZHIPU_API_KEY
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# AI_MODEL_CHEAP=                  # override the model of an OpenAI-compatible engine
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GLM_BASE_URL=https://api.z.ai/api/openai/v1

# --- Research data (only needed to re-download data for research/) -------------------------
DATABENTO_API_KEY=
# SEC requires a User-Agent with contact details, e.g. "your-name your@email.com"
SEC_USER_AGENT=

# --- Development ---------------------------------------------------------------------------
# INVESTOR_FALLBACK_ENV=           # path to a second .env read after this one
# INVESTOR_SMOKE_PAPER_WRITE=1     # let tests/smoke_alpaca.py place a $3 PAPER order
